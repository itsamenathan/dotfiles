#
# !!!!!!!!!!!!!!!!!!! DON'T EDIT !!!!!!!!!!!!!!!!
# edit: ~/.config/yadm/alt/.zshrc##template
#

# antidote install
[[ -e ${ZDOTDIR:-~}/.antidote ]] ||
  git clone https://github.com/mattmc3/antidote.git ${ZDOTDIR:-~}/.antidote

export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/Library/Caches}/oh-my-zsh"
mkdir -p "$ZSH_CACHE_DIR/completions"
zstyle ':completion:*' menu select
zstyle ':antidote:bundle' use-friendly-names 'yes'
zstyle ':omz:plugins:ssh-agent' agent-forwarding yes

# antidote setup
source ${ZDOTDIR:-~}/.antidote/antidote.zsh

# drop fpath entries that don't exist (eg. unused nix paths from /etc/zshenv)
# so compinit doesn't waste time statting dead directories
fpath=($^fpath(N-/))

# antidote plugins
# plugin list lives in ~/.zsh_plugins.txt; antidote compiles it to
# ~/.zsh_plugins.zsh and only recompiles when the txt file changes
antidote load

export PATH="$HOOME:/bin:$HOME/.local/bin:$PATH"

{% if yadm.hostname == "endeavour" %}
  export TMUX_AUTO_START=off
{% endif %}

# cache oh-my-posh's generated init script; only regenerate when the
# config file changes instead of shelling out to oh-my-posh every shell start
_omp_cache="$ZSH_CACHE_DIR/omp_init.zsh"
if [[ ! -s "$_omp_cache" || ~/.ohmyposh.yaml -nt "$_omp_cache" ]]; then
  oh-my-posh init zsh --config ~/.ohmyposh.yaml > "$_omp_cache"
fi
source "$_omp_cache"
# the cached script bakes in a fixed session id; give each shell its own
export POSH_SESSION_ID="${$}-${RANDOM}${RANDOM}"
unset _omp_cache
